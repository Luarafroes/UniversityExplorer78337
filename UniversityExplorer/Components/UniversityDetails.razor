<div class="card border-0 shadow-sm rounded-4 overflow-hidden">

    <div class="card-header border-0 p-4"
         style="background: #183653;">

        <div class="d-flex justify-content-between align-items-center">
            <div>
                <small class="text-uppercase fw-semibold"
                       style="color: #83D6B0;">
                    UNIVERSITY PROFILE
                </small>

                <h5 class="fw-bold text-white mb-0 mt-1">
                    University Details
                </h5>
            </div>

            <button class="btn btn-sm btn-outline-light rounded-pill"
                    @onclick="HandleClose">
                ✕ Close
            </button>
        </div>
    </div>

    <div class="card-body p-4">

        <div class="mb-3">
            <small class="text-muted d-block">University Name</small>
            <strong style="color: #183653;">
                @University.Name
            </strong>
        </div>

        <div class="mb-3">
            <small class="text-muted d-block">Country</small>
            <strong>@University.Country</strong>
        </div>

        <div class="mb-3">
            <small class="text-muted d-block mb-1">Official Website</small>

            @if (!string.IsNullOrWhiteSpace(University.WebPages?.FirstOrDefault()))
            {
                <a href="@University.WebPages.First()"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="text-primary text-decoration-none">
                    Visit University Website ↗
                </a>
            }
            else
            {
                <span class="text-muted">No website available</span>
            }
        </div>

        <div>
            <small class="text-muted d-block mb-1">Domains</small>

            @if (University.Domains?.Any() == true)
            {
                @foreach (var domain in University.Domains)
                {
                    <span class="badge rounded-pill me-1 mb-1"
                          style="background: #E7F1FA; color: #183653;">
                        @domain
                    </span>
                }
            }
            else
            {
                <span class="text-muted">No domains available</span>
            }
        </div>

    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public University University { get; set; } = default!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task HandleClose()
    {
        await OnClose.InvokeAsync();
    }
}