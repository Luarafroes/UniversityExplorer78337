@inject IJSRuntime JS

<button type="button"
        class="btn btn-sm theme-toggle"
        title="Switch between light and dark mode"
        aria-label="Switch between light and dark mode"
        @onclick="Toggle">
    @(isDark ? "☀️ Light" : "🌙 Dark")
</button>

@code {
    private bool isDark;

    // Runs after the page is on screen: read the theme that theme.js applied
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("themeInterop.get");
            isDark = theme == "dark";
            StateHasChanged();
        }
    }

    // Switch theme and remember it in Local Storage
    private async Task Toggle()
    {
        isDark = !isDark;
        await JS.InvokeVoidAsync("themeInterop.set", isDark ? "dark" : "light");
    }
}