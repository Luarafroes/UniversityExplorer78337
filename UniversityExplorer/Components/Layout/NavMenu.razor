<nav class="navbar navbar-expand-lg navbar-dark app-navbar sticky-top">
    <div class="container">

        <a class="navbar-brand fw-bold" href="">
            🎓 University Explorer
        </a>

        <button class="navbar-toggler" type="button"
                aria-label="Toggle navigation"
                @onclick="ToggleMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="@NavMenuCssClass navbar-collapse" @onclick="CloseMenu">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        Home
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="university-explorer">
                        University Explorer
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="student-applications" Match="NavLinkMatch.All">
                        Student Applications
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="student-applications/create">
                        Create Student Application
                    </NavLink>
                </li>
            </ul>
        </div>

    </div>
</nav>

@code {
    // Controls the menu on small screens (the "hamburger" button)
    private bool expanded;

    // Adds the Bootstrap class "show" when the menu is open
    private string NavMenuCssClass => expanded ? "collapse show" : "collapse";

    private void ToggleMenu() => expanded = !expanded;

    // Closes the menu after clicking a link on a small screen
    private void CloseMenu() => expanded = false;
}