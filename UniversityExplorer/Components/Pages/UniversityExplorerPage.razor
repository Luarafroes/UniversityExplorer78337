@page "/university-explorer"
@inject CountryService CountryService
@inject UniversityService UniversityService
@inject NavigationManager Navigation

<PageTitle>University Explorer</PageTitle>

<div class="mb-4">
    <h1 class="mb-1">University Explorer</h1>
    <p class="text-muted mb-0">Choose a country to see its details and the universities there.</p>
</div>

@* Country dropdown *@
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <label for="countrySelect" class="form-label fw-semibold">Country</label>

        @if (isLoadingCountries)
        {
            <div class="d-flex align-items-center">
                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                <span>Loading countries...</span>
            </div>
        }
        else if (countriesError)
        {
            <div class="alert alert-danger mb-0">
                Unable to retrieve countries. Please try again later.
            </div>
        }
        else
        {
            <select id="countrySelect" class="form-select form-select-lg"
                    value="@selectedCountryName" @onchange="OnCountryChanged">
                <option value="">Select Country</option>
                @foreach (var country in countries)
                {
                    <option value="@country.Name">@country.Name</option>
                }
            </select>
        }
    </div>
</div>

@* Show the country information and its universities *@
@if (selectedCountry != null)
{
    <div class="row g-4">
        <div class="col-lg-4">
            <CountryDetails Country="selectedCountry" />
        </div>

        <div class="col-lg-8">
            <h3 class="mb-3">Universities in @selectedCountry.Name</h3>

            @if (isLoadingUniversities)
            {
                <div class="d-flex align-items-center">
                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                    <span>Loading universities...</span>
                </div>
            }
            else if (universitiesError)
            {
                <div class="alert alert-danger">
                    Unable to retrieve universities. Please try again later.
                </div>
            }
            else if (universities.Count == 0)
            {
                <div class="alert alert-info">
                    No universities found for @selectedCountry.Name.
                </div>
            }
            else
            {
                var filtered = FilteredUniversities;
                var totalPages = Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)PageSize));

                // If there are fewer pages after searching, go back to the last available page
                if (currentPage > totalPages) currentPage = totalPages;

                var pageItems = filtered.Skip((currentPage - 1) * PageSize).Take(PageSize).ToList();
                var firstShown = filtered.Count == 0 ? 0 : (currentPage - 1) * PageSize + 1;
                var lastShown = (currentPage - 1) * PageSize + pageItems.Count;

                <input class="form-control form-control-lg mb-2"
                       @bind="SearchText" @bind:event="oninput"
                       placeholder="Search university..." />

                <p class="text-muted small">
                    Showing @firstShown–@lastShown of @filtered.Count universities
                    @if (filtered.Count != universities.Count)
                    {
                        <span>(filtered from @universities.Count)</span>
                    }
                </p>

                @if (filtered.Count == 0)
                {
                    <div class="alert alert-warning">No universities match "@SearchText".</div>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        @foreach (var uni in pageItems)
                        {
                            <div class="col">
                                <UniversityCard University="uni" OnSelect="ShowUniversityDetails" />
                            </div>
                        }
                    </div>

                    @* Buttons to move between pages *@
                    @if (totalPages > 1)
                    {
                        <nav aria-label="Universities pages" class="mt-4">
                            <ul class="pagination justify-content-center flex-wrap mb-0">

                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">
                                        ‹ Previous
                                    </button>
                                </li>

                                @foreach (var p in VisiblePages(totalPages))
                                {
                                    <li class="page-item @(p == currentPage ? "active" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(p)">@p</button>
                                    </li>
                                }

                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">
                                        Next ›
                                    </button>
                                </li>

                            </ul>
                            <p class="text-center text-muted small mt-2 mb-0">
                                Page @currentPage of @totalPages
                            </p>
                        </nav>
                    }
                }
            }
        </div>
    </div>
}
else if (!isLoadingCountries && !countriesError)
{
    <div class="text-center text-muted py-5">
        <h4>👆 Select a country to get started</h4>
    </div>
}

@code {
    // Number of universities to show on each page
    private const int PageSize = 12;

    private List<Country> countries = new();
    private List<University> universities = new();

    private Country? selectedCountry;
    private string? selectedCountryName;

    private bool isLoadingCountries = true;
    private bool isLoadingUniversities;
    private bool countriesError;
    private bool universitiesError;

    private int currentPage = 1;
    private string searchText = "";

    // This updates the search while the user is typing and resets the page
    public string SearchText
    {
        get => searchText;
        set
        {
            searchText = value;
            currentPage = 1;
        }
    }

    // Get the universities that match what the user typed
    private List<University> FilteredUniversities =>
        universities
            .Where(u => u.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
            .ToList();

    // Load the countries when the page first opens
    protected override async Task OnInitializedAsync()
    {
        try
        {
            countries = await CountryService.GetCountriesAsync();
        }
        catch
        {
            countriesError = true;
        }
        finally
        {
            isLoadingCountries = false;
        }
    }

    // This method runs when a different country is selected
    private async Task OnCountryChanged(ChangeEventArgs e)
    {
        selectedCountryName = e.Value?.ToString();
        selectedCountry = countries.FirstOrDefault(c => c.Name == selectedCountryName);

        // Clear the old universities and search when changing countries
        universities = new List<University>();
        SearchText = "";
        currentPage = 1;
        universitiesError = false;

        if (selectedCountry == null) return;

        // Get the universities for the selected country
        isLoadingUniversities = true;
        try
        {
            universities = await UniversityService.GetUniversitiesAsync(selectedCountry.Name);
        }
        catch
        {
            universitiesError = true;
        }
        finally
        {
            isLoadingUniversities = false;
        }
    }

    // Change to the page selected by the user
    private void GoToPage(int page)
    {
        currentPage = page;
    }

    // Show up to 5 page numbers at a time
    private IEnumerable<int> VisiblePages(int totalPages)
    {
        var start = Math.Max(1, currentPage - 2);
        var end = Math.Min(totalPages, start + 4);
        start = Math.Max(1, end - 4);
        return Enumerable.Range(start, end - start + 1);
    }

    // When a university card is clicked, open its details page
    private void ShowUniversityDetails(University university)
    {
        Navigation.NavigateTo(
            $"/university-details?country={Uri.EscapeDataString(university.Country)}&name={Uri.EscapeDataString(university.Name)}");
    }
}
